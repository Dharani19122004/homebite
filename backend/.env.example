# Copy this file to .env and fill in your own values. Never commit the real .env.
PORT=5000

# MongoDB Atlas connection string. Add the database name after the host,
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/HomeBite?appName=Cluster0
MONGO_URI=
# Used only when MONGO_URI has no database name (default: HomeBite)
# MONGO_DB_NAME=HomeBite

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your website address (Vercel URL, no trailing slash). Leave empty for local development.
# Several allowed: https://a.vercel.app,https://b.vercel.app
FRONTEND_URL=

EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: estimated arrival window (minutes) in the delivery-assigned notification.
# DELIVERY_ETA_MIN_MINUTES=25
# DELIVERY_ETA_MAX_MINUTES=35
